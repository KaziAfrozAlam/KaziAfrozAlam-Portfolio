# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — safe to expose to the browser (publishable key)
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy alias still supported by the client:
# VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ─────────────────────────────────────────────────────────────
# Edge functions / server-only — NEVER expose these to the browser.
# For deployed functions, set these with:  supabase secrets set KEY=value
# (do not rely on .env for production edge-function secrets)
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI agent secret (used by supabase/functions/ai-agent)
AGENT_API_KEY=

# Local Supabase CLI
SUPABASE_DB_PASSWORD=your-db-password
